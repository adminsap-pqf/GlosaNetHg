<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
	xmlns:tx="http://www.springframework.org/schema/tx"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-4.1.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context-4.1.xsd
    http://www.springframework.org/schema/tx
	http://www.springframework.org/schema/tx/spring-tx-4.1.xsd">

	<!-- ************ SPRING CONFIG *********** -->
	<context:annotation-config />

	<context:component-scan base-package="org.mx.persistencia" />
	<context:component-scan base-package="org.mx.resource" />
	<context:component-scan base-package="org.mx.servicio.seguridad" />

	<context:component-scan base-package="org.mx.servicio.comun.impl" />
	<context:component-scan base-package="org.mx.servicio.catalogo.impl" />
	<context:component-scan base-package="org.mx.servicio.automatico.impl" />
	<context:component-scan base-package="org.mx.servicio.datastage.impl" />
	<context:component-scan base-package="org.mx.servicio.descomprimir.impl" />
	<context:component-scan base-package="org.mx.servicio.permisos.org.mx.servicio.impl" />
	<context:component-scan base-package="org.mx.servicio.registros.impl" />
	<context:component-scan base-package="org.mx.servicio.reporte.impl" />
	<context:component-scan base-package="org.mx.servicio.jobs.datastage.loader.phase1.messaging.impl" />
	<context:component-scan base-package="org.mx.servicio.jobs.datastage.loader.phase1.processing.impl" />
	<context:component-scan base-package="org.mx.servicio.jobs.datastage.vucem.messaging.impl" />
	<context:component-scan base-package="org.mx.servicio.jobs.datastage.vucem.partitioning.impl" />
	<context:component-scan base-package="org.mx.servicio.cargasAdicionales.impl" />

	<!-- ************ MESSAGE BROKER *********** -->
	<context:component-scan base-package="ryndem.mx.glosanet.messagebroker" />

	<!-- ************ JPA CONFIG *********** -->
	<bean id="entityManagerFactory"
		  class="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean">
		<property name="dataSource" ref="restDemoDS" />
		<property name="packagesToScan">
			<list>
				<value>org.mx.modelo</value>
				<value>ryndem.mx.glosanet.messagebroker.datastage.loader.phase1.model</value>
				<value>ryndem.mx.glosanet.messagebroker.datastage.vucem.model</value>
			</list>
		</property>
		<property name="jpaVendorAdapter">
			<bean class="org.springframework.orm.jpa.vendor.HibernateJpaVendorAdapter" />
		</property>
		<property name="jpaProperties">
			<props>
				<prop key="hibernate.current_session_context_class">thread</prop>
				<prop key="hibernate.show.sql">false</prop>
				<prop key="hibernate.dialect">org.hibernate.dialect.MySQL5Dialect</prop>
			</props>
		</property>
	</bean>
	<bean id="restDemoDS"
		  class="org.springframework.jdbc.datasource.DriverManagerDataSource">
		<property name="driverClassName" value="com.mysql.cj.jdbc.Driver" />
